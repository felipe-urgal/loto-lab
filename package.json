{
  "name": "loto-lab",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test",
    "api:start": "npm run build && node dist/src/cli/apiStart.js",
    "data:sync": "npm run build && node dist/src/cli/sync.js",
    "data:refresh": "npm run build && node dist/src/cli/refresh.js",
    "games:generate": "npm run build && node dist/src/cli/generateGames.js",
    "games:check": "npm run build && node dist/src/cli/checkGames.js",
    "backtest:mega": "npm run build && node dist/src/cli/backtestMega.js",
    "backtest:lotofacil": "npm run build && node dist/src/cli/backtestLotofacil.js",
    "backtest:dia": "npm run build && node dist/src/cli/backtestDiaDeSorte.js",
    "backtest:compare": "npm run build && node dist/src/cli/compareStrategies.js",
    "db:migrate": "npm run build && node dist/src/cli/dbMigrate.js",
    "db:import-json": "npm run build && node dist/src/cli/dbImportJson.js",
    "db:sync": "npm run build && node dist/src/cli/dbSync.js"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.0",
    "typescript": "^5.9.2"
  }
}
