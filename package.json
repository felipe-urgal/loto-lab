{
  "name": "loto-lab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "web:build": "node scripts/buildWeb.mjs",
    "build": "npm run build:server && npm run web:build",
    "build:prod": "tsc -p tsconfig.build.json && npm run web:build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test",
    "e2e:browser": "node scripts/e2eBrowser.mjs && node scripts/e2eAnalysisLotteries.mjs && node scripts/e2eGeneratorV2.mjs && node scripts/e2eMyGamesV2.mjs && node scripts/e2eReadability.mjs && node scripts/e2eCriticalRoutes.mjs && node scripts/e2eOperationalFlows.mjs",
    "api:start": "npm run build && node --env-file-if-exists=.env dist/src/cli/apiStart.js",
    "data:sync": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/sync.js",
    "data:refresh": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/refresh.js",
    "games:generate": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/generateGames.js",
    "games:check": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/checkGames.js",
    "backtest:mega": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/backtestMega.js",
    "backtest:lotofacil": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/backtestLotofacil.js",
    "backtest:dia": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/backtestDiaDeSorte.js",
    "backtest:compare": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/compareStrategies.js",
    "db:migrate": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbMigrate.js",
    "db:import-json": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbImportJson.js",
    "db:sync": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbSync.js",
    "db:bootstrap": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbBootstrap.js",
    "db:status": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbStatus.js",
    "db:profile": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/dbProfile.js",
    "ops:sync": "npm run build:server && node --env-file-if-exists=.env dist/src/cli/opsSync.js",
    "ops:backup": "node --env-file-if-exists=.env.production scripts/backupPostgres.mjs",
    "ops:restore-check": "node --env-file-if-exists=.env.production scripts/verifyBackup.mjs",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f app"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.0",
    "typescript": "^5.9.2"
  }
}
