{
  "version": 1,
  "production": {
    "enabled": true,
    "strategy": "command",
    "provider": "docker-compose",
    "branch": "main",
    "documentation": "docs/PRODUCTION-CONTRACT.md",
    "commands": {
      "status": "prod:status",
      "check": "prod:check",
      "backup": "prod:backup",
      "deploy": "prod:deploy",
      "verify": "prod:verify",
      "restoreCheck": "prod:restore-check",
      "logs": "prod:logs"
    },
    "policies": {
      "backup": "required-before-deploy",
      "migrations": "startup",
      "rollback": "manual-restore"
    }
  }
}
