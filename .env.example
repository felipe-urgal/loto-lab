DATABASE_URL=postgresql://loto_lab:loto_lab@localhost:5434/loto_lab
API_HOST=127.0.0.1
API_PORT=5200
# Em desenvolvimento local, deixe API_CORS_ORIGIN e PUBLIC_ORIGIN sem definir.
# Assim o backend deriva a origem do próprio Host e aceita localhost ou 127.0.0.1.
# Configure uma origem explícita apenas quando a API for consumida por outro origin.
OPS_AUTO_SYNC=true
OPS_INTERVAL_MINUTES=30
OPS_STALE_AFTER_MINUTES=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
