# Public application
# Keep 127.0.0.1 when using a TLS reverse proxy on the same host.
# If APP_BIND is non-loopback (for example 0.0.0.0), PUBLIC_ORIGIN must use https://
# because production authentication uses HTTP Basic credentials.
APP_BIND=127.0.0.1
APP_PORT=5200
PUBLIC_ORIGIN=http://localhost:5200
# Emergency/local exception only. Do not enable on an untrusted network.
ALLOW_INSECURE_PUBLIC_HTTP=false
LOTO_LAB_IMAGE_TAG=latest

# Application authentication
# Production requires HTTP Basic authentication for the entire UI/API except health checks.
APP_AUTH_USER=loto-admin
APP_AUTH_PASSWORD=change-this-to-a-long-random-password

# PostgreSQL
POSTGRES_DB=loto_lab
POSTGRES_USER=loto_lab
POSTGRES_PASSWORD=change-this-to-a-different-long-random-password

# Operational scheduler
OPS_AUTO_SYNC=true
OPS_INTERVAL_MINUTES=30
OPS_STALE_AFTER_MINUTES=180
OPS_SHUTDOWN_TIMEOUT_SECONDS=25

# Optional AI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
