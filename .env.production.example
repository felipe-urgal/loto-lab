# Public application
# Keep 127.0.0.1 when using a reverse proxy on the same host.
# Set 0.0.0.0 only when you intentionally want Docker to expose the app directly.
APP_BIND=127.0.0.1
APP_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
LOTO_LAB_IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=loto_lab
POSTGRES_USER=loto_lab
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Operational scheduler
OPS_AUTO_SYNC=true
OPS_INTERVAL_MINUTES=30
OPS_STALE_AFTER_MINUTES=180

# Optional AI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
